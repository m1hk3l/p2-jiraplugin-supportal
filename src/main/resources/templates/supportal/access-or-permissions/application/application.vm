<div class="application-info-container">
    <p class="application-info-container-text line-default" data-i18n data-en="Here you can request access to the applications you need. Review the list below and submit your requests. All requests will be reviewed and processed according to company guidelines." data-et="Siin saate taotleda ligipääsu vajalikele rakendustele. Vaadake allolev nimekiri üle ja esitage oma taotlused. Kõiki taotlusi vaadatakse üle ja töödeldakse vastavalt ettevõtte juhistele." data-ru="Здесь вы можете запросить доступ к необходимым приложениям. Просмотрите список ниже и отправьте свои запросы. Все запросы будут рассмотрены и обработаны в соответствии с правилами компании.">Here you can request access to the applications you need. Review the list below and submit your requests. All requests will be reviewed and processed according to company guidelines.</p>
</div>

<div style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
    <div class="app-container">
        <h1 id="app-title" class="app-title">Applications</h1>
        <div class="app-search-container">
            <div class="app-search-wrapper">
                <div class="app-search-icon">
                    <i class="pi pi-search"></i>
                </div>
                <input class="app-search-input" id="app-search" type="text" placeholder="Search applications..." autocomplete="off" spellcheck="false"/>
            </div>
        </div>
        <div class="app-results-info">
            <span id="results-count">Loading...</span>
        </div>
        <div class="app-grid-container">
            <div class="app-grid" id="applications-grid">
                <div class="app-loading-state">
                    <div class="app-loading-spinner"></div>
                    <div id="loading-text">Loading applications...</div>
                </div>
            </div>
        </div>

        <div id="app-detail-panel" class="app-detail-panel" hidden>
            <div class="app-detail-panel-header">
                <div class="app-detail-panel-heading">
                    <span class="app-detail-panel-icon"><i class="pi pi-th-large"></i></span>
                    <h2 class="app-detail-title"></h2>
                </div>
                <button class="app-detail-panel-close" aria-label="Close" type="button">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M5 5L15 15M15 5L5 15"></path>
                    </svg>
                </button>
            </div>
            <div class="app-detail-panel-body">

                <div id="form-view">
                    <form id="access-form">
                        <div class="form-group" id="description-section" style="display:none;">
                            <label class="form-label" id="label-description">Description</label>
                            <div class="form-description" id="form-description"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" id="label-user">User <span class="required">*</span></label>
                            <div class="user-picker" id="user-picker">
                                <div class="user-picker-trigger" id="user-picker-trigger" tabindex="0">
                                    <i class="pi pi-user user-picker-icon"></i>
                                    <span class="user-picker-value" id="user-picker-value">Select user...</span>
                                    <i class="pi pi-chevron-down user-picker-arrow" id="user-picker-arrow"></i>
                                </div>
                                <div class="user-picker-dropdown" id="user-picker-dropdown">
                                    <div class="user-picker-search-wrap">
                                        <i class="pi pi-search user-picker-search-icon"></i>
                                        <input type="text" class="user-picker-search" id="user-picker-search" placeholder="Search user..." autocomplete="off" spellcheck="false"/>
                                        <button class="user-picker-clear-search" id="user-picker-clear-search" style="display:none;" type="button" aria-label="Clear search">
                                            <i class="pi pi-times"></i>
                                        </button>
                                    </div>
                                    <div class="user-picker-list" id="user-picker-list">
                                        <div class="user-picker-empty">
                                            <i class="pi pi-search" style="font-size:20px;opacity:0.3;margin-bottom:8px;display:block;"></i>
                                            <span id="users-type-to-search">Type to search users...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="user-select" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" id="label-adgroup">AD group <span class="required">*</span></label>
                            <div class="user-picker" id="adgroup-picker">
                                <div class="user-picker-trigger" id="adgroup-picker-trigger" tabindex="0">
                                    <i class="pi pi-users user-picker-icon"></i>
                                    <span class="user-picker-value" id="adgroup-picker-value">Select AD group...</span>
                                    <i class="pi pi-chevron-down user-picker-arrow" id="adgroup-picker-arrow"></i>
                                </div>
                                <div class="user-picker-dropdown" id="adgroup-picker-dropdown">
                                    <div class="user-picker-search-wrap">
                                        <i class="pi pi-search user-picker-search-icon"></i>
                                        <input type="text" class="user-picker-search" id="adgroup-picker-search" placeholder="Search AD group..." autocomplete="off" spellcheck="false"/>
                                        <button class="user-picker-clear-search" id="adgroup-picker-clear-search" style="display:none;" type="button" aria-label="Clear search">
                                            <i class="pi pi-times"></i>
                                        </button>
                                    </div>
                                    <div class="user-picker-list" id="adgroup-picker-list">
                                        <div class="user-picker-empty" id="adgroup-picker-empty"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-hint" id="adgroup-hint" style="display:none;"></div>
                            <input type="hidden" id="adgroup-select" />
                        </div>

                        <div class="form-group">
                            <label for="business-reason" class="form-label" id="label-business-reason">Business reason and comments <span class="required">*</span></label>
                            <textarea id="business-reason" class="form-textarea" rows="4" placeholder="Describe the reason..." required></textarea>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="app-btn app-btn-primary" id="submit-add-btn">Submit request</button>
                        </div>
                    </form>
                </div>

                <div id="loading-view" style="display:none;">
                    <div class="loading-message">
                        <div class="loading-icon"><i class="pi pi-spin pi-spinner" style="font-size:32px;"></i></div>
                        <p class="loading-text" id="submit-loading-text">Submitting request...</p>
                    </div>
                </div>

                <div id="success-view" style="display:none;">
                    <div class="success-message">
                        <div class="success-icon"><i class="pi pi-check"></i></div>
                        <p class="success-text" id="success-text">Request submitted successfully.</p>
                        <p class="success-subtext" id="success-subtext">
                            <span id="success-subtext-label">You can view your open requests here:</span>
                            <a href="$!{baseUrl}/plugins/servlet/supportal" class="success-link" id="success-link">My open requests</a>
                        </p>
                        <p class="success-subtext" id="success-created-subtext" style="display:none;">
                            <span id="success-created-label">Created issue key is</span>
                            <a href="#" class="success-link" id="success-created-link"></a>
                        </p>
                    </div>
                </div>

                <div id="error-view" style="display:none;">
                    <div class="error-message">
                        <div class="error-icon"><i class="pi pi-times"></i></div>
                        <p class="error-text" id="error-text">Failed to submit request.</p>
                        <p class="error-subtext" id="error-subtext">Please try again later or contact the IT team.</p>
                        <div class="form-actions" style="margin-top: 20px;">
                            <button class="app-btn app-btn-primary" id="retry-btn">Try again</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="other-access-or-permissions">
        <span id="other-access-text">Don't see what you're looking for?</span>
        <a href="#" data-jira-url="https://jiradev.energia.sise/jira/servicedesk/customer/portal/31/create/354"
           class="other-access-or-permissions-link" id="other-access-link"
           rel="noopener noreferrer">Request other access or permissions</a>
    </div>
</div>
#parse("templates/supportal/_shell_bottom.vm")

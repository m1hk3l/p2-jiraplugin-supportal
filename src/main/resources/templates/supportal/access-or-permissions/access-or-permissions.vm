                        <a href="$!{baseUrl}/servicedesk/customer/portal/31/create/366" class="open-in-modal alt-option not-taken">
                            <div class="alt-circle"><i class="pi pi-times-circle"></i></div>
                            <div class="alt-label label-tiny" id="step2-alt6"></div>
                        </a>
                    </div>
                </li>

                <li class="journey-step active">
                    <a href="$!{baseUrl}/plugins/servlet/supportal/access-or-permissions" class="step-main">
                        <div class="step-circle"><i class="pi pi-key"></i></div>
                        <div class="step-label label-small" id="step3-main"></div>
                        <div class="current-indicator label-minimum" id="current-indicator"></div>

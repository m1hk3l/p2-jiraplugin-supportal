               data-i18n-attr="href"
               data-en-href="$!{baseUrl}/servicedesk/customer/portal/31/create/354?summary=Access%20to%20database"
               data-et-href="$!{baseUrl}/servicedesk/customer/portal/31/create/354?summary=Ligip%C3%A4%C3%A4s%20andmebaasile"
               data-ru-href="$!{baseUrl}/servicedesk/customer/portal/31/create/354?summary=%D0%94%D0%BE%D1%81%D1%82%D1%83%D0%BF%20%D0%BA%20%D0%B1%D0%B0%D0%B7%D0%B5%20%D0%B4%D0%B0%D0%BD%D0%BD%D1%8B%D1%85"
               href="$!{baseUrl}/servicedesk/customer/portal/31/create/354?summary=Access%20to%20database">
                <div class="need-card-icon"><i class="pi pi-database"></i></div>
                <div class="need-card-title label-small"><span data-i18n data-en="Database" data-et="Andmebaas" data-ru="База данных">Database</span><span class="tooltip-container"><i class="pi pi-info-circle info-icon"></i><span class="tooltip-text"><p data-i18n data-en="Permissions for database usage" data-et="Andmebaasi kasutamiseks vajalikud õigused" data-ru="Права для работы с базой данных">Permissions for database usage</p></span></span></div>
            </a>
            <a class="need-card" id="need-card-usb-rights"
               href="$!{baseUrl}/plugins/servlet/supportal/access-or-permissions/usb-rights">
                <div class="need-card-icon"><i class="pi pi-upload"></i></div>

               href="$!{baseUrl}/servicedesk/customer/portal/31/create/352?summary=External%20user%20account%20creation">
                <div class="need-card-icon"><i class="pi pi-users"></i></div>
                <div class="need-card-title label-small"><span data-i18n data-en="External user account creation" data-et="Väliskasutaja konto loomine" data-ru="Создание учётной записи внешнего пользователя">External user account creation</span><span class="tooltip-container"><i class="pi pi-info-circle info-icon"></i><span class="tooltip-text"><p data-i18n data-en="Request for creating external user accounts" data-et="Väliskasutaja konto loomise taotlus" data-ru="Запрос на создание учётной записи внешнего пользователя">Request for creating external user accounts</p></span></span></div>
            </a>
            <a class="need-card" id="need-card-email"
               href="$!{baseUrl}/plugins/servlet/supportal/access-or-permissions/email-and-distribution-list">
                <div class="need-card-icon"><i class="pi pi-envelope"></i></div>
                <div class="need-card-title label-small"><span data-i18n data-en="Email and distribution list" data-et="E-post ja meililist" data-ru="Электронная почта и список рассылки">Email and distribution list</span><span class="tooltip-container"><i class="pi pi-info-circle info-icon"></i><span class="tooltip-text"><p data-i18n data-en="Access to email and distribution lists" data-et="E-post ja meililisti õigused" data-ru="Доступ к почте и спискам рассылки">Access to email and distribution lists</p></span></span></div>
            </a>
            <a class="need-card" id="need-card-somewhere-else"
               href="$!{baseUrl}/plugins/servlet/supportal/access-or-permissions/somewhere-else">
